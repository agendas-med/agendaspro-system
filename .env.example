# Copie para .env (NÃO versione o .env). Todos os valores abaixo são públicos no bundle do front.

# URL base da API (core). Também entra no connect-src da CSP gerada em public/_headers.
NUXT_PUBLIC_API_BASE=http://localhost:3001

# URL do site institucional (links de Termos de Uso e Política de Privacidade: /termos e /privacidade).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Client ID OAuth do Google (apenas o client id, nunca o secret). Vazio = login com Google desativado.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
